<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Bros Sports Championship - Pixel Edition</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; -webkit-user-select: none; font-family: 'Courier New', Courier, monospace; }
    body { background: #070a12; color: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; padding: 10px; overflow: hidden; }
    .top-bar { display: flex; justify-content: space-between; align-items: center; width: 100%; max-width: 800px; margin-bottom: 8px; }
    .brand { font-size: 1.35rem; font-weight: 900; color: #ffbe0b; letter-spacing: 1px; }
    .hud { background: #141b2d; border: 2px solid #2b3a55; padding: 6px 14px; border-radius: 8px; font-weight: 800; font-size: 0.9rem; color: #4cc9f0; }
    .stage { position: relative; width: 100%; max-width: 800px; border-radius: 12px; overflow: hidden; box-shadow: 0 15px 40px rgba(0,0,0,0.8); border: 4px solid #334155; }
    canvas { display: block; width: 100%; height: auto; background: #0f172a; touch-action: none; image-rendering: pixelated; }
    .menu { position: absolute; inset: 0; background: rgba(7, 10, 18, 0.95); display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 20px; text-align: center; z-index: 20; }
    .menu h1 { font-size: 2rem; color: #ffbe0b; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 2px; }
    .menu p { color: #94a3b8; margin-bottom: 18px; font-size: 0.9rem; }
    .cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; width: 100%; max-width: 620px; margin-bottom: 16px; }
    .card { background: #1e293b; border: 3px solid #475569; border-radius: 10px; padding: 16px; cursor: pointer; transition: 0.15s; }
    .card:hover, .card:active { border-color: #ffbe0b; transform: translateY(-3px); background: #263349; }
    .card .icon { font-size: 2.5rem; margin-bottom: 6px; }
    .card h3 { color: #ffbe0b; font-size: 1.15rem; margin-bottom: 4px; }
    .card span { font-size: 0.8rem; color: #cbd5e1; display: block; }
    .char-row { display: flex; gap: 10px; margin-bottom: 16px; flex-wrap: wrap; justify-content: center; }
    .char-btn { background: #0f172a; border: 2px solid #475569; color: #fff; padding: 8px 14px; border-radius: 8px; cursor: pointer; font-size: 0.85rem; font-weight: 800; }
    .char-btn.active { border-color: #ffbe0b; background: #1e293b; color: #ffbe0b; }
    .controls { display: flex; gap: 10px; margin-top: 10px; flex-wrap: wrap; justify-content: center; width: 100%; max-width: 800px; }
    button.btn { background: #ffbe0b; color: #070a12; border: none; padding: 12px 22px; font-size: 1rem; font-weight: 900; border-radius: 8px; cursor: pointer; }
    button.btn:active { transform: scale(0.95); }
    button.blue { background: #3a86ff; color: #fff; }
    button.red { background: #e63946; color: #fff; }
  </style>
</head>
<body>

<div class="top-bar">
  <div class="brand">🏆 PIXEL CHAMPIONSHIP</div>
  <div class="hud" id="hudText">SELECT A SPORT</div>
</div>

<div class="stage">
  <canvas id="game" width="800" height="500"></canvas>

  <div class="menu" id="mainMenu">
    <h1>PIXEL CHAMPIONSHIP</h1>
    <p>Choose your team & step into the retro stadium!</p>

    <div class="char-row" id="charPicker">
      <div class="char-btn active" data-idx="0">🇧🇷 BRAZIL (Balanced)</div>
      <div class="char-btn" data-idx="1">🇦🇷 ARGENTINA (Power)</div>
      <div class="char-btn" data-idx="2">🇫🇷 FRANCE (Speed)</div>
    </div>

    <div class="cards">
      <div class="card" onclick="launchSport('ragdoll')">
        <div class="icon">⚽</div>
        <h3>PIXEL WORLD CUP</h3>
        <span>Retro Stadium • Slingshot Ragdoll Physics • Cup Bracket</span>
      </div>
      <div class="card" onclick="launchSport('baseball')">
        <div class="icon">⚾</div>
        <h3>SLUGGER BROS PRO</h3>
        <span>3-Inning Game • Curveballs • Base Runners & Fireworks</span>
      </div>
    </div>
  </div>
</div>

<div class="controls" id="ctrlBar" style="display:none;">
  <button class="btn blue" id="leftBtn" onpointerdown="holdLeft=true" onpointerup="holdLeft=false" onpointerleave="holdLeft=false">◀ LEFT</button>
  <button class="btn" id="mainActionBtn" onpointerdown="triggerAction()">ACTION</button>
  <button class="btn blue" id="rightBtn" onpointerdown="holdRight=true" onpointerup="holdRight=false" onpointerleave="holdRight=false">RIGHT ▶</button>
  <button class="btn red" onclick="backToMenu()">↩ MENU</button>
</div>

<script>
const canvas = document.getElementById('game');
const ctx = canvas.getContext('2d');
const mainMenu = document.getElementById('mainMenu');
const ctrlBar = document.getElementById('ctrlBar');
const hudText = document.getElementById('hudText');
const mainActionBtn = document.getElementById('mainActionBtn');

// Retro Sound Synthesizer
const actx = new (window.AudioContext || window.webkitAudioContext)();
function sfx(freq, type, dur, slide=0) {
  if (actx.state === 'suspended') actx.resume();
  const o = actx.createOscillator(), g = actx.createGain();
  o.type = type; o.connect(g); g.connect(actx.destination);
  o.frequency.setValueAtTime(freq, actx.currentTime);
  if (slide) o.frequency.exponentialRampToValueAtTime(slide, actx.currentTime + dur);
  g.gain.setValueAtTime(0.2, actx.currentTime);
  g.gain.exponentialRampToValueAtTime(0.01, actx.currentTime + dur);
  o.start(); o.stop(actx.currentTime + dur);
}

const TEAMS = [
  { code: "BRA", jersey: "#facc15", shorts: "#1d4ed8", hair: "#451a03", power: 1.0, speed: 1.0 },
  { code: "ARG", jersey: "#38bdf8", shorts: "#0f172a", hair: "#1e1b18", power: 1.22, speed: 0.85 },
  { code: "FRA", jersey: "#1e3a8a", shorts: "#ffffff", hair: "#78350f", power: 0.9, speed: 1.25 }
];
let selectedTeam = TEAMS;

document.querySelectorAll('.char-btn').forEach(btn => {
  btn.onclick = () => {
    document.querySelectorAll('.char-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    selectedTeam = TEAMS[Number(btn.dataset.idx)];
    sfx(520, 'square', 0.08);
  };
});

let currentSport = '';
let holdLeft = false, holdRight = false;
let particles = [];
let banner = { text: '', timer: 0 };

function popBanner(txt, time=85) { banner = { text: txt, timer: time }; }
function spawnParticles(x, y, col, count=25) {
  for (let i = 0; i < count; i++) {
    const a = Math.random() * Math.PI * 2, sp = 2 + Math.random() * 6;
    particles.push({ x, y, vx: Math.cos(a)*sp, vy: Math.sin(a)*sp, life: 45, col });
  }
}

function backToMenu() {
  currentSport = '';
  mainMenu.style.display = 'flex';
  ctrlBar.style.display = 'none';
  hudText.textContent = 'SELECT A SPORT';
}

function launchSport(sport) {
  currentSport = sport;
  mainMenu.style.display = 'none';
  ctrlBar.style.display = 'flex';
  particles = [];
  if (sport === 'baseball') initBaseball();
  if (sport === 'ragdoll') initRagdoll();
}

// ==========================================
// SPORT 1: PIXEL WORLD CUP (RETRO STADIUM)
// ==========================================
let rg = {};
const ROUNDS = ["QUARTERFINAL", "SEMIFINAL", "WORLD CUP FINAL"];
const OPPONENTS = [
  { code: "SWE", jersey: "#1d4ed8", shorts: "#facc15", hair: "#fde047" },
  { code: "GER", jersey: "#f8fafc", shorts: "#0f172a", hair: "#92400e" },
  { code: "ESP", jersey: "#dc2626", shorts: "#1e3a8a", hair: "#1c1917" }
];

// Pre-generate pixelated stadium crowd dots for authentic retro look
const crowdDots = [];
for (let row = 0; row < 14; row++) {
  for (let col = 0; col < 90; col++) {
    const colors = ["#334155", "#475569", "#64748b", "#94a3b8", "#facc15", "#38bdf8", "#ef4444", "#ffffff"];
    crowdDots.push({
      x: col * 9 + (row % 2) * 4,
      y: 85 + row * 13,
      c: colors[Math.floor(Math.random() * colors.length)]
    });
  }
}

function initRagdoll() {
  mainActionBtn.textContent = "⚡ SLING LAUNCH (DRAG OR TAP)";
  document.getElementById('leftBtn').style.display = 'none';
  document.getElementById('rightBtn').style.display = 'none';
  rg = {
    round: 0, pScore: 0, cpuScore: 0, timer: 45 * 60,
    drag: false, dragStart: {x:0,y:0}, dragEnd: {x:0,y:0},
    p1: { x: 210, y: 395, vx: 0, vy: 0, angle: 0, va: 0 },
    p2: { x: 590, y: 395, vx: 0, vy: 0, angle: 0, va: 0, aiTimer: 0 },
    ball: { x: 400, y: 210, vx: 0, vy: 0, r: 14, rot: 0 }
  };
  updateRGHud();
  popBanner(`${ROUNDS[rg.round]}: ${selectedTeam.code} VS ${OPPONENTS[rg.round].code}`);
}

function updateRGHud() {
  const sec = Math.ceil(rg.timer / 60);
  hudText.textContent = `${ROUNDS[rg.round]} • ${sec}"`;
}

function resetRGPositions() {
  rg.p1 = { x: 210, y: 395, vx: 0, vy: 0, angle: 0, va: 0 };
  rg.p2 = { x: 590, y: 395, vx: 0, vy: 0, angle: 0, va: 0, aiTimer: 20 };
  rg.ball = { x: 400, y: 190, vx: (Math.random()-0.5)*3, vy: 0, r: 14, rot: 0 };
}

function launchP1(dx, dy) {
  const power = Math.min(22, Math.hypot(dx, dy) * 0.16) * selectedTeam.power;
  const ang = Math.atan2(dy, dx);
  rg.p1.vx = Math.cos(ang) * power;
  rg.p1.vy = Math.sin(ang) * power - 3.5;
  rg.p1.va = (rg.p1.vx > 0 ? 0.24 : -0.24);
  sfx(260, 'square', 0.12, 460);
}

function updateRagdoll() {
  if (rg.timer > 0) {
    rg.timer--;
    if (rg.timer % 60 === 0) updateRGHud();
  } else {
    if (rg.pScore > rg.cpuScore) {
      if (rg.round >= 2) {
        popBanner(`🏆 ${selectedTeam.code} WINS THE WORLD CUP!`, 180);
        spawnParticles(400, 200, '#facc15', 60);
        setTimeout(() => initRagdoll(), 3200);
        rg.timer = 9999;
        return;
      }
      rg.round++; rg.pScore = 0; rg.cpuScore = 0; rg.timer = 45 * 60;
      resetRGPositions();
      popBanner(`NEXT: ${ROUNDS[rg.round]} VS ${OPPONENTS[rg.round].code}`);
      updateRGHud();
    } else if (rg.pScore < rg.cpuScore) {
      popBanner("💀 ELIMINATED! TRY AGAIN", 150);
